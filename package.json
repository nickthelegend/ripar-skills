{
  "name": "@ripar/skills",
  "version": "0.1.0",
  "description": "Ripar's agent-interoperability layer: an MCP server over the live Algorand registries, plus A2A agent-card discovery. Reads are on-chain, writes come back unsigned.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ripar-skills": "./dist/bin/mcp-stdio.js",
    "ripar-skills-mcp": "./dist/bin/mcp-stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/bin/mcp-stdio.js",
    "card": "node dist/bin/serve-card.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "a2a",
    "agent",
    "algorand",
    "x402",
    "ripar",
    "agent-card"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "algosdk": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/ripar-skills.git"
  }
}
